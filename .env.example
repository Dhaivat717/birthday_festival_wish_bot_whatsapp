# Required: Google Gemini API Key (get one free at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model to use ('auto' automatically queries Google's API to pick the newest flash-lite/flash model)
GEMINI_MODEL=auto

# Optional: Phone number for 8-digit pairing code login instead of QR code (useful on cloud servers!)
# Format: country code + number, digits only, no '+' or spaces (e.g. 14155552671 or 919876543210)
PAIRING_PHONE_NUMBER=

# Group Whitelist: Comma-separated list of Group Names (case-insensitive substring or exact match)
# OR Group JIDs (e.g. 120363012345678901@g.us).
# Leave empty ONLY if you want to inspect group names/IDs on first startup without replying anywhere.
ALLOWED_GROUPS=Family,College Friends,Work Team

# How many unique people must send a wish in the group before the bot triggers (e.g. 2 or 3)
MIN_WISHERS=2

# Sliding time window (in minutes) within which those wishes must occur
WINDOW_MINUTES=45

# Minimum cooldown before wishing for the same event/person again in a group (default: 48 hours = 2 days)
COOLDOWN_HOURS=48

# Also enforce a minimum cooldown between ANY two auto-wishes in the same group (in hours)
# Set to 48 if you want the bot to wait at least 2 days before sending ANY wish again in the same group,
# or set to 0 to only apply the 2-day cooldown per specific birthday/festival event.
GROUP_GLOBAL_COOLDOWN_HOURS=0

# Human-like random delay range before sending the reply (in seconds)
MIN_DELAY_SECONDS=45
MAX_DELAY_SECONDS=180

# Your personal style/persona hint for Gemini when crafting wishes on your behalf
USER_STYLE_PROMPT=Keep it warm, natural, casual, and concise (1 short sentence). Match the language/vibe of the other group members. Do not sound overly formal or robotic.

# Persistent directory for WhatsApp session and cooldown state (mount a volume here in Railway/Fly/Docker)
DATA_DIR=./data
